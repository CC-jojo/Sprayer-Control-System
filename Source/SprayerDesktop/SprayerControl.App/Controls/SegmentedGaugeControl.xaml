<UserControl x:Class="SprayerControl.App.Controls.SegmentedGaugeControl"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="160" MinHeight="160"
             MouseLeftButtonDown="OnMouseLeftButtonDown"
             MouseMove="OnMouseMove"
             MouseLeftButtonUp="OnMouseLeftButtonUp"
             LostMouseCapture="OnLostMouseCapture"
             TouchDown="OnTouchDown"
             TouchMove="OnTouchMove"
             TouchUp="OnTouchUp"
             LostTouchCapture="OnLostTouchCapture">
    <Viewbox Stretch="Uniform">
        <Grid Width="280" Height="280">
            <Canvas Width="280" Height="280">
                <Rectangle x:Name="Segment01" Width="14" Height="38" Canvas.Left="133" Canvas.Top="10" RenderTransformOrigin="0.5,3.2"><Rectangle.RenderTransform><RotateTransform Angle="0" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment02" Width="14" Height="38" Canvas.Left="133" Canvas.Top="10" RenderTransformOrigin="0.5,3.2"><Rectangle.RenderTransform><RotateTransform Angle="18" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment03" Width="14" Height="38" Canvas.Left="133" Canvas.Top="10" RenderTransformOrigin="0.5,3.2"><Rectangle.RenderTransform><RotateTransform Angle="36" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment04" Width="14" Height="38" Canvas.Left="133" Canvas.Top="10" RenderTransformOrigin="0.5,3.2"><Rectangle.RenderTransform><RotateTransform Angle="54" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment05" Width="14" Height="38" Canvas.Left="133" Canvas.Top="10" RenderTransformOrigin="0.5,3.2"><Rectangle.RenderTransform><RotateTransform Angle="72" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment06" Width="14" Height="38" Canvas.Left="133" Canvas.Top="10" RenderTransformOrigin="0.5,3.2"><Rectangle.RenderTransform><RotateTransform Angle="90" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment07" Width="14" Height="38" Canvas.Left="133" Canvas.Top="10" RenderTransformOrigin="0.5,3.2"><Rectangle.RenderTransform><RotateTransform Angle="108" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment08" Width="14" Height="38" Canvas.Left="133" Canvas.Top="10" RenderTransformOrigin="0.5,3.2"><Rectangle.RenderTransform><RotateTransform Angle="126" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment09" Width="14" Height="38" Canvas.Left="133" Canvas.Top="10" RenderTransformOrigin="0.5,3.2"><Rectangle.RenderTransform><RotateTransform Angle="144" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment10" Width="14" Height="38" Canvas.Left="133" Canvas.Top="10" RenderTransformOrigin="0.5,3.2"><Rectangle.RenderTransform><RotateTransform Angle="162" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment11" Width="14" Height="38" Canvas.Left="133" Canvas.Top="10" RenderTransformOrigin="0.5,3.2"><Rectangle.RenderTransform><RotateTransform Angle="180" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment12" Width="14" Height="38" Canvas.Left="133" Canvas.Top="10" RenderTransformOrigin="0.5,3.2"><Rectangle.RenderTransform><RotateTransform Angle="198" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment13" Width="14" Height="38" Canvas.Left="133" Canvas.Top="10" RenderTransformOrigin="0.5,3.2"><Rectangle.RenderTransform><RotateTransform Angle="216" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment14" Width="14" Height="38" Canvas.Left="133" Canvas.Top="10" RenderTransformOrigin="0.5,3.2"><Rectangle.RenderTransform><RotateTransform Angle="234" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment15" Width="14" Height="38" Canvas.Left="133" Canvas.Top="10" RenderTransformOrigin="0.5,3.2"><Rectangle.RenderTransform><RotateTransform Angle="252" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment16" Width="14" Height="38" Canvas.Left="133" Canvas.Top="10" RenderTransformOrigin="0.5,3.2"><Rectangle.RenderTransform><RotateTransform Angle="270" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment17" Width="14" Height="38" Canvas.Left="133" Canvas.Top="10" RenderTransformOrigin="0.5,3.2"><Rectangle.RenderTransform><RotateTransform Angle="288" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment18" Width="14" Height="38" Canvas.Left="133" Canvas.Top="10" RenderTransformOrigin="0.5,3.2"><Rectangle.RenderTransform><RotateTransform Angle="306" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment19" Width="14" Height="38" Canvas.Left="133" Canvas.Top="10" RenderTransformOrigin="0.5,3.2"><Rectangle.RenderTransform><RotateTransform Angle="324" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment20" Width="14" Height="38" Canvas.Left="133" Canvas.Top="10" RenderTransformOrigin="0.5,3.2"><Rectangle.RenderTransform><RotateTransform Angle="342" /></Rectangle.RenderTransform></Rectangle>
            </Canvas>
            <Border Width="154" Height="154" Background="{DynamicResource HmiPanelBrush}" BorderBrush="{DynamicResource HmiBorderBrush}" BorderThickness="2" CornerRadius="77" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="设定值" Foreground="{DynamicResource HmiMutedTextBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding PreviewValue, ElementName=Root, StringFormat={}{0:F0}%}" Foreground="{DynamicResource HmiTextBrush}" FontSize="36" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="拖动后松开确认" Foreground="{DynamicResource HmiMutedTextBrush}" FontSize="12" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Viewbox>
</UserControl>
