<UserControl x:Class="SprayerControl.App.Controls.SegmentedGaugeControl"
             x:Name="Root" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" MinWidth="150" MinHeight="150"
             MouseLeftButtonDown="OnMouseLeftButtonDown" MouseMove="OnMouseMove" MouseLeftButtonUp="OnMouseLeftButtonUp"
             LostMouseCapture="OnLostMouseCapture" TouchDown="OnTouchDown" TouchMove="OnTouchMove" TouchUp="OnTouchUp" LostTouchCapture="OnLostTouchCapture">
    <Viewbox Stretch="Uniform">
        <Grid Width="280" Height="250">
            <Canvas Width="280" Height="250">
                <Path Data="M 49,192 A 105,105 0 1 1 231,192" Stroke="{DynamicResource HmiBorderBrush}" StrokeThickness="2" Fill="Transparent" />
                <Rectangle x:Name="Segment01" Width="18" Height="40" Canvas.Left="131" Canvas.Top="8" RenderTransformOrigin="0.5,3.3"><Rectangle.RenderTransform><RotateTransform Angle="-120" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment02" Width="18" Height="40" Canvas.Left="131" Canvas.Top="8" RenderTransformOrigin="0.5,3.3"><Rectangle.RenderTransform><RotateTransform Angle="-100" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment03" Width="18" Height="40" Canvas.Left="131" Canvas.Top="8" RenderTransformOrigin="0.5,3.3"><Rectangle.RenderTransform><RotateTransform Angle="-80" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment04" Width="18" Height="40" Canvas.Left="131" Canvas.Top="8" RenderTransformOrigin="0.5,3.3"><Rectangle.RenderTransform><RotateTransform Angle="-60" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment05" Width="18" Height="40" Canvas.Left="131" Canvas.Top="8" RenderTransformOrigin="0.5,3.3"><Rectangle.RenderTransform><RotateTransform Angle="-40" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment06" Width="18" Height="40" Canvas.Left="131" Canvas.Top="8" RenderTransformOrigin="0.5,3.3"><Rectangle.RenderTransform><RotateTransform Angle="-20" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment07" Width="18" Height="40" Canvas.Left="131" Canvas.Top="8" RenderTransformOrigin="0.5,3.3"><Rectangle.RenderTransform><RotateTransform Angle="0" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment08" Width="18" Height="40" Canvas.Left="131" Canvas.Top="8" RenderTransformOrigin="0.5,3.3"><Rectangle.RenderTransform><RotateTransform Angle="20" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment09" Width="18" Height="40" Canvas.Left="131" Canvas.Top="8" RenderTransformOrigin="0.5,3.3"><Rectangle.RenderTransform><RotateTransform Angle="40" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment10" Width="18" Height="40" Canvas.Left="131" Canvas.Top="8" RenderTransformOrigin="0.5,3.3"><Rectangle.RenderTransform><RotateTransform Angle="60" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment11" Width="18" Height="40" Canvas.Left="131" Canvas.Top="8" RenderTransformOrigin="0.5,3.3"><Rectangle.RenderTransform><RotateTransform Angle="80" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment12" Width="18" Height="40" Canvas.Left="131" Canvas.Top="8" RenderTransformOrigin="0.5,3.3"><Rectangle.RenderTransform><RotateTransform Angle="100" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment13" Width="18" Height="40" Canvas.Left="131" Canvas.Top="8" RenderTransformOrigin="0.5,3.3"><Rectangle.RenderTransform><RotateTransform Angle="120" /></Rectangle.RenderTransform></Rectangle>
            </Canvas>
            <Border Width="142" Height="142" Background="{DynamicResource HmiBackgroundBrush}" BorderBrush="{DynamicResource HmiBorderBrush}" BorderThickness="2" CornerRadius="71" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,6">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding PreviewValue, ElementName=Root, StringFormat={}{0:F0}%}" Foreground="{DynamicResource HmiTextBrush}" FontSize="43" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="松开后发送" Foreground="{DynamicResource HmiMutedTextBrush}" FontSize="11" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding Minimum, ElementName=Root, StringFormat={}{0:F0}%}" Foreground="{DynamicResource HmiMutedTextBrush}" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="30,0,0,6" />
            <TextBlock Text="{Binding Maximum, ElementName=Root, StringFormat={}{0:F0}%}" Foreground="{DynamicResource HmiMutedTextBrush}" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,6" />
        </Grid>
    </Viewbox>
</UserControl>
