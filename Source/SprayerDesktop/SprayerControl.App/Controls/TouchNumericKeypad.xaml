<UserControl x:Class="SprayerControl.App.Controls.TouchNumericKeypad"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="240">
    <Border Style="{StaticResource HmiCardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="数值输入" Style="{StaticResource HmiHeadingStyle}" />
            <Border Grid.Row="0" Margin="0,38,0,12" Padding="12" Background="{DynamicResource HmiRaisedPanelBrush}" BorderBrush="{DynamicResource HmiBorderBrush}" BorderThickness="1" CornerRadius="8">
                <TextBlock Text="{Binding Text, ElementName=Root}" Foreground="{DynamicResource HmiTextBrush}" FontSize="28" HorizontalAlignment="Right" />
            </Border>
            <UniformGrid Grid.Row="1" Rows="4" Columns="3" Margin="0,8">
                <Button Content="1" Tag="1" Style="{StaticResource TouchButtonStyle}" Click="OnKeyClick" />
                <Button Content="2" Tag="2" Style="{StaticResource TouchButtonStyle}" Click="OnKeyClick" />
                <Button Content="3" Tag="3" Style="{StaticResource TouchButtonStyle}" Click="OnKeyClick" />
                <Button Content="4" Tag="4" Style="{StaticResource TouchButtonStyle}" Click="OnKeyClick" />
                <Button Content="5" Tag="5" Style="{StaticResource TouchButtonStyle}" Click="OnKeyClick" />
                <Button Content="6" Tag="6" Style="{StaticResource TouchButtonStyle}" Click="OnKeyClick" />
                <Button Content="7" Tag="7" Style="{StaticResource TouchButtonStyle}" Click="OnKeyClick" />
                <Button Content="8" Tag="8" Style="{StaticResource TouchButtonStyle}" Click="OnKeyClick" />
                <Button Content="9" Tag="9" Style="{StaticResource TouchButtonStyle}" Click="OnKeyClick" />
                <Button Content="." Tag="." Style="{StaticResource TouchButtonStyle}" Click="OnKeyClick" />
                <Button Content="0" Tag="0" Style="{StaticResource TouchButtonStyle}" Click="OnKeyClick" />
                <Button Content="退格" Tag="backspace" Style="{StaticResource TouchButtonStyle}" Click="OnKeyClick" />
            </UniformGrid>
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="清除" Tag="clear" Style="{StaticResource TouchButtonStyle}" Click="OnKeyClick" />
                <Button Grid.Column="1" Content="取消" Style="{StaticResource TouchButtonStyle}" Click="OnCancelClick" />
                <Button Grid.Column="2" Content="确认" Style="{StaticResource StatusButtonStyle}" CommandParameter="{Binding Text, ElementName=Root}" Click="OnConfirmClick" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
