<UserControl x:Class="SprayerControl.App.Controls.NozzleArrayControl"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SprayerControl.App.Controls"
             MinWidth="200" MinHeight="240">
    <UserControl.Resources>
        <Style x:Key="CircularNozzleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="56" />
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="NozzleDiscTemplate">
            <Viewbox Stretch="Uniform" Width="96" Height="96">
                <Grid Width="70" Height="70">
                    <Ellipse Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                             Stroke="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="2" />
                    <Ellipse Width="38" Height="38" Fill="{DynamicResource HmiTextBrush}" Opacity="0.48" />
                    <Ellipse Width="15" Height="15" Fill="{DynamicResource HmiPanelBrush}" />
                </Grid>
            </Viewbox>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="56" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" /><RowDefinition Height="*" />
            <RowDefinition Height="*" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="第1组" Style="{StaticResource HmiHeadingStyle}" FontSize="16" VerticalAlignment="Center" />
        <TextBlock Grid.Row="1" Text="第2组" Style="{StaticResource HmiHeadingStyle}" FontSize="16" VerticalAlignment="Center" />
        <TextBlock Grid.Row="2" Text="第3组" Style="{StaticResource HmiHeadingStyle}" FontSize="16" VerticalAlignment="Center" />
        <TextBlock Grid.Row="3" Text="第4组" Style="{StaticResource HmiHeadingStyle}" FontSize="16" VerticalAlignment="Center" />

        <Button x:Name="Nozzle1LeftButton" Grid.Row="0" Grid.Column="1" Style="{StaticResource CircularNozzleButtonStyle}" Margin="5" Command="{Binding Command, ElementName=Root}" Content="喷嘴" ContentTemplate="{StaticResource NozzleDiscTemplate}"><Button.CommandParameter><local:NozzleCommandParameter Group="1" Right="False" /></Button.CommandParameter></Button>
        <Button x:Name="Nozzle1RightButton" Grid.Row="0" Grid.Column="2" Style="{StaticResource CircularNozzleButtonStyle}" Margin="5" Command="{Binding Command, ElementName=Root}" Content="喷嘴" ContentTemplate="{StaticResource NozzleDiscTemplate}"><Button.CommandParameter><local:NozzleCommandParameter Group="1" Right="True" /></Button.CommandParameter></Button>
        <Button x:Name="Nozzle2LeftButton" Grid.Row="1" Grid.Column="1" Style="{StaticResource CircularNozzleButtonStyle}" Margin="5" Command="{Binding Command, ElementName=Root}" Content="喷嘴" ContentTemplate="{StaticResource NozzleDiscTemplate}"><Button.CommandParameter><local:NozzleCommandParameter Group="2" Right="False" /></Button.CommandParameter></Button>
        <Button x:Name="Nozzle2RightButton" Grid.Row="1" Grid.Column="2" Style="{StaticResource CircularNozzleButtonStyle}" Margin="5" Command="{Binding Command, ElementName=Root}" Content="喷嘴" ContentTemplate="{StaticResource NozzleDiscTemplate}"><Button.CommandParameter><local:NozzleCommandParameter Group="2" Right="True" /></Button.CommandParameter></Button>
        <Button x:Name="Nozzle3LeftButton" Grid.Row="2" Grid.Column="1" Style="{StaticResource CircularNozzleButtonStyle}" Margin="5" Command="{Binding Command, ElementName=Root}" Content="喷嘴" ContentTemplate="{StaticResource NozzleDiscTemplate}"><Button.CommandParameter><local:NozzleCommandParameter Group="3" Right="False" /></Button.CommandParameter></Button>
        <Button x:Name="Nozzle3RightButton" Grid.Row="2" Grid.Column="2" Style="{StaticResource CircularNozzleButtonStyle}" Margin="5" Command="{Binding Command, ElementName=Root}" Content="喷嘴" ContentTemplate="{StaticResource NozzleDiscTemplate}"><Button.CommandParameter><local:NozzleCommandParameter Group="3" Right="True" /></Button.CommandParameter></Button>
        <Button x:Name="Nozzle4LeftButton" Grid.Row="3" Grid.Column="1" Style="{StaticResource CircularNozzleButtonStyle}" Margin="5" Command="{Binding Command, ElementName=Root}" Content="喷嘴" ContentTemplate="{StaticResource NozzleDiscTemplate}"><Button.CommandParameter><local:NozzleCommandParameter Group="4" Right="False" /></Button.CommandParameter></Button>
        <Button x:Name="Nozzle4RightButton" Grid.Row="3" Grid.Column="2" Style="{StaticResource CircularNozzleButtonStyle}" Margin="5" Command="{Binding Command, ElementName=Root}" Content="喷嘴" ContentTemplate="{StaticResource NozzleDiscTemplate}"><Button.CommandParameter><local:NozzleCommandParameter Group="4" Right="True" /></Button.CommandParameter></Button>
    </Grid>
</UserControl>
