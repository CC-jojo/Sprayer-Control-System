<UserControl x:Class="SprayerControl.App.Controls.NozzleArrayControl"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SprayerControl.App.Controls"
             MinWidth="200" MinHeight="300">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Button x:Name="Nozzle1LeftButton" Grid.Row="0" Grid.Column="0" Style="{StaticResource TouchButtonStyle}" MinWidth="56" MinHeight="56" Margin="8" Command="{Binding Command, ElementName=Root}">
            <Button.CommandParameter><local:NozzleCommandParameter Group="1" Right="False" /></Button.CommandParameter>
            <Viewbox Stretch="Uniform"><Grid Width="62" Height="62"><Ellipse Fill="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Stroke="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="4" /><Ellipse Width="30" Height="30" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" /></Grid></Viewbox>
        </Button>
        <TextBlock Grid.Row="0" Grid.Column="1" Text="第 1 组喷嘴" Foreground="{DynamicResource HmiTextBrush}" VerticalAlignment="Center" Margin="10" />
        <Button x:Name="Nozzle1RightButton" Grid.Row="0" Grid.Column="2" Style="{StaticResource TouchButtonStyle}" MinWidth="56" MinHeight="56" Margin="8" Command="{Binding Command, ElementName=Root}">
            <Button.CommandParameter><local:NozzleCommandParameter Group="1" Right="True" /></Button.CommandParameter>
            <Viewbox Stretch="Uniform"><Grid Width="62" Height="62"><Ellipse Fill="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Stroke="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="4" /><Ellipse Width="30" Height="30" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" /></Grid></Viewbox>
        </Button>

        <Button x:Name="Nozzle2LeftButton" Grid.Row="1" Grid.Column="0" Style="{StaticResource TouchButtonStyle}" MinWidth="56" MinHeight="56" Margin="8" Command="{Binding Command, ElementName=Root}">
            <Button.CommandParameter><local:NozzleCommandParameter Group="2" Right="False" /></Button.CommandParameter>
            <Viewbox Stretch="Uniform"><Grid Width="62" Height="62"><Ellipse Fill="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Stroke="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="4" /><Ellipse Width="30" Height="30" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" /></Grid></Viewbox>
        </Button>
        <TextBlock Grid.Row="1" Grid.Column="1" Text="第 2 组喷嘴" Foreground="{DynamicResource HmiTextBrush}" VerticalAlignment="Center" Margin="10" />
        <Button x:Name="Nozzle2RightButton" Grid.Row="1" Grid.Column="2" Style="{StaticResource TouchButtonStyle}" MinWidth="56" MinHeight="56" Margin="8" Command="{Binding Command, ElementName=Root}">
            <Button.CommandParameter><local:NozzleCommandParameter Group="2" Right="True" /></Button.CommandParameter>
            <Viewbox Stretch="Uniform"><Grid Width="62" Height="62"><Ellipse Fill="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Stroke="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="4" /><Ellipse Width="30" Height="30" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" /></Grid></Viewbox>
        </Button>

        <Button x:Name="Nozzle3LeftButton" Grid.Row="2" Grid.Column="0" Style="{StaticResource TouchButtonStyle}" MinWidth="56" MinHeight="56" Margin="8" Command="{Binding Command, ElementName=Root}">
            <Button.CommandParameter><local:NozzleCommandParameter Group="3" Right="False" /></Button.CommandParameter>
            <Viewbox Stretch="Uniform"><Grid Width="62" Height="62"><Ellipse Fill="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Stroke="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="4" /><Ellipse Width="30" Height="30" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" /></Grid></Viewbox>
        </Button>
        <TextBlock Grid.Row="2" Grid.Column="1" Text="第 3 组喷嘴" Foreground="{DynamicResource HmiTextBrush}" VerticalAlignment="Center" Margin="10" />
        <Button x:Name="Nozzle3RightButton" Grid.Row="2" Grid.Column="2" Style="{StaticResource TouchButtonStyle}" MinWidth="56" MinHeight="56" Margin="8" Command="{Binding Command, ElementName=Root}">
            <Button.CommandParameter><local:NozzleCommandParameter Group="3" Right="True" /></Button.CommandParameter>
            <Viewbox Stretch="Uniform"><Grid Width="62" Height="62"><Ellipse Fill="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Stroke="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="4" /><Ellipse Width="30" Height="30" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" /></Grid></Viewbox>
        </Button>

        <Button x:Name="Nozzle4LeftButton" Grid.Row="3" Grid.Column="0" Style="{StaticResource TouchButtonStyle}" MinWidth="56" MinHeight="56" Margin="8" Command="{Binding Command, ElementName=Root}">
            <Button.CommandParameter><local:NozzleCommandParameter Group="4" Right="False" /></Button.CommandParameter>
            <Viewbox Stretch="Uniform"><Grid Width="62" Height="62"><Ellipse Fill="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Stroke="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="4" /><Ellipse Width="30" Height="30" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" /></Grid></Viewbox>
        </Button>
        <TextBlock Grid.Row="3" Grid.Column="1" Text="第 4 组喷嘴" Foreground="{DynamicResource HmiTextBrush}" VerticalAlignment="Center" Margin="10" />
        <Button x:Name="Nozzle4RightButton" Grid.Row="3" Grid.Column="2" Style="{StaticResource TouchButtonStyle}" MinWidth="56" MinHeight="56" Margin="8" Command="{Binding Command, ElementName=Root}">
            <Button.CommandParameter><local:NozzleCommandParameter Group="4" Right="True" /></Button.CommandParameter>
            <Viewbox Stretch="Uniform"><Grid Width="62" Height="62"><Ellipse Fill="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Stroke="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="4" /><Ellipse Width="30" Height="30" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" /></Grid></Viewbox>
        </Button>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="左" Foreground="{DynamicResource HmiMutedTextBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4" IsHitTestVisible="False" />
        <TextBlock Grid.Row="0" Grid.Column="2" Text="右" Foreground="{DynamicResource HmiMutedTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4" IsHitTestVisible="False" />
    </Grid>
</UserControl>
