<UserControl x:Class="SprayerControl.App.Controls.NozzleArrayControl"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="180" MinHeight="240">
    <UserControl.Resources>
        <DataTemplate x:Key="NozzleDiscTemplate">
            <Viewbox Stretch="Uniform">
                <Grid Width="56" Height="56">
                    <Ellipse Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}"
                             Stroke="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}" StrokeThickness="2" />
                    <Ellipse Width="30" Height="30" Fill="{DynamicResource HmiTextBrush}" Opacity="0.48" />
                    <Ellipse Width="12" Height="12" Fill="{DynamicResource HmiPanelBrush}" />
                </Grid>
            </Viewbox>
        </DataTemplate>
        <!-- 透明点击层：无任何视觉，只接收点击并转发 NozzleClicked 事件 -->
        <Style x:Key="NozzleHitButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <!-- 4 行 3 列：[左圆盘 | 组名文字 | 右圆盘]。外层 Viewbox 整体等比缩放，
         内部 Grid 用固定宽高比 (260 x 480) 保证不挤压外部布局。 -->
    <Viewbox Stretch="Uniform" StretchDirection="Both">
        <Grid x:Name="NozzleLayout" Width="260" Height="480">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <!-- 组名文字居中 -->
            <TextBlock Grid.Row="0" Grid.Column="1" Text="第1组" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource HmiHeadingStyle}" FontSize="20" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="第2组" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource HmiHeadingStyle}" FontSize="20" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="第3组" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource HmiHeadingStyle}" FontSize="20" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="第4组" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource HmiHeadingStyle}" FontSize="20" />

            <!-- 第1组：左圆盘在列0，右圆盘在列2 -->
            <Grid Grid.Row="0" Grid.Column="0" Margin="4">
                <ContentControl x:Name="Nozzle1LeftIndicator" Content="喷嘴"
                                ContentTemplate="{StaticResource NozzleDiscTemplate}"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                Foreground="{DynamicResource HmiMutedTextBrush}" BorderBrush="{DynamicResource HmiBorderBrush}"
                                IsHitTestVisible="False" Focusable="False"
                                AutomationProperties.Name="第 1 组左侧喷嘴" />
                <Button x:Name="Nozzle1LeftButton" Tag="1,0" Click="Nozzle_Click" Style="{StaticResource NozzleHitButtonStyle}"
                        AutomationProperties.Name="第 1 组左侧喷嘴，点击切换" />
            </Grid>
            <Grid Grid.Row="0" Grid.Column="2" Margin="4">
                <ContentControl x:Name="Nozzle1RightIndicator" Content="喷嘴"
                                ContentTemplate="{StaticResource NozzleDiscTemplate}"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                Foreground="{DynamicResource HmiMutedTextBrush}" BorderBrush="{DynamicResource HmiBorderBrush}"
                                IsHitTestVisible="False" Focusable="False"
                                AutomationProperties.Name="第 1 组右侧喷嘴" />
                <Button x:Name="Nozzle1RightButton" Tag="1,1" Click="Nozzle_Click" Style="{StaticResource NozzleHitButtonStyle}"
                        AutomationProperties.Name="第 1 组右侧喷嘴，点击切换" />
            </Grid>

            <!-- 第2组 -->
            <Grid Grid.Row="1" Grid.Column="0" Margin="4">
                <ContentControl x:Name="Nozzle2LeftIndicator" Content="喷嘴"
                                ContentTemplate="{StaticResource NozzleDiscTemplate}"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                Foreground="{DynamicResource HmiMutedTextBrush}" BorderBrush="{DynamicResource HmiBorderBrush}"
                                IsHitTestVisible="False" Focusable="False"
                                AutomationProperties.Name="第 2 组左侧喷嘴" />
                <Button x:Name="Nozzle2LeftButton" Tag="2,0" Click="Nozzle_Click" Style="{StaticResource NozzleHitButtonStyle}"
                        AutomationProperties.Name="第 2 组左侧喷嘴，点击切换" />
            </Grid>
            <Grid Grid.Row="1" Grid.Column="2" Margin="4">
                <ContentControl x:Name="Nozzle2RightIndicator" Content="喷嘴"
                                ContentTemplate="{StaticResource NozzleDiscTemplate}"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                Foreground="{DynamicResource HmiMutedTextBrush}" BorderBrush="{DynamicResource HmiBorderBrush}"
                                IsHitTestVisible="False" Focusable="False"
                                AutomationProperties.Name="第 2 组右侧喷嘴" />
                <Button x:Name="Nozzle2RightButton" Tag="2,1" Click="Nozzle_Click" Style="{StaticResource NozzleHitButtonStyle}"
                        AutomationProperties.Name="第 2 组右侧喷嘴，点击切换" />
            </Grid>

            <!-- 第3组 -->
            <Grid Grid.Row="2" Grid.Column="0" Margin="4">
                <ContentControl x:Name="Nozzle3LeftIndicator" Content="喷嘴"
                                ContentTemplate="{StaticResource NozzleDiscTemplate}"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                Foreground="{DynamicResource HmiMutedTextBrush}" BorderBrush="{DynamicResource HmiBorderBrush}"
                                IsHitTestVisible="False" Focusable="False"
                                AutomationProperties.Name="第 3 组左侧喷嘴" />
                <Button x:Name="Nozzle3LeftButton" Tag="3,0" Click="Nozzle_Click" Style="{StaticResource NozzleHitButtonStyle}"
                        AutomationProperties.Name="第 3 组左侧喷嘴，点击切换" />
            </Grid>
            <Grid Grid.Row="2" Grid.Column="2" Margin="4">
                <ContentControl x:Name="Nozzle3RightIndicator" Content="喷嘴"
                                ContentTemplate="{StaticResource NozzleDiscTemplate}"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                Foreground="{DynamicResource HmiMutedTextBrush}" BorderBrush="{DynamicResource HmiBorderBrush}"
                                IsHitTestVisible="False" Focusable="False"
                                AutomationProperties.Name="第 3 组右侧喷嘴" />
                <Button x:Name="Nozzle3RightButton" Tag="3,1" Click="Nozzle_Click" Style="{StaticResource NozzleHitButtonStyle}"
                        AutomationProperties.Name="第 3 组右侧喷嘴，点击切换" />
            </Grid>

            <!-- 第4组 -->
            <Grid Grid.Row="3" Grid.Column="0" Margin="4,4,4,8">
                <ContentControl x:Name="Nozzle4LeftIndicator" Content="喷嘴"
                                ContentTemplate="{StaticResource NozzleDiscTemplate}"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                Foreground="{DynamicResource HmiMutedTextBrush}" BorderBrush="{DynamicResource HmiBorderBrush}"
                                IsHitTestVisible="False" Focusable="False"
                                AutomationProperties.Name="第 4 组左侧喷嘴" />
                <Button x:Name="Nozzle4LeftButton" Tag="4,0" Click="Nozzle_Click" Style="{StaticResource NozzleHitButtonStyle}"
                        AutomationProperties.Name="第 4 组左侧喷嘴，点击切换" />
            </Grid>
            <Grid Grid.Row="3" Grid.Column="2" Margin="4,4,4,8">
                <ContentControl x:Name="Nozzle4RightIndicator" Content="喷嘴"
                                ContentTemplate="{StaticResource NozzleDiscTemplate}"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                Foreground="{DynamicResource HmiMutedTextBrush}" BorderBrush="{DynamicResource HmiBorderBrush}"
                                IsHitTestVisible="False" Focusable="False"
                                AutomationProperties.Name="第 4 组右侧喷嘴" />
                <Button x:Name="Nozzle4RightButton" Tag="4,1" Click="Nozzle_Click" Style="{StaticResource NozzleHitButtonStyle}"
                        AutomationProperties.Name="第 4 组右侧喷嘴，点击切换" />
            </Grid>
        </Grid>
    </Viewbox>
</UserControl>