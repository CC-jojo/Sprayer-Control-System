<Window x:Class="SprayerControl.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SprayerControl.App.Views"
        Title="施药机控制系统" WindowStyle="None" WindowState="Maximized"
        Background="{DynamicResource HmiBackgroundBrush}" MinWidth="640" MinHeight="480">
    <Grid Background="{DynamicResource HmiBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="64" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Background="{DynamicResource HmiBackgroundBrush}" BorderBrush="{DynamicResource HmiBorderBrush}" BorderThickness="0,0,0,1" Padding="20,0">
            <DockPanel LastChildFill="False">
                <TextBlock Text="施药机控制系统" Style="{StaticResource HmiHeadingStyle}" FontSize="27" VerticalAlignment="Center" DockPanel.Dock="Left" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right">
                    <Ellipse x:Name="HeaderConnectionDot" Width="15" Height="15" Fill="{DynamicResource HmiAmberBrush}" Margin="0,0,8,0" />
                    <TextBlock x:Name="ConnectionText" Text="正在自动查找控制器" Foreground="{DynamicResource HmiGreenBrush}" FontSize="17" VerticalAlignment="Center" Margin="0,0,24,0" />
                    <Border Width="1" Height="34" Background="{DynamicResource HmiBorderBrush}" Margin="0,0,18,0"/>
                    <Button Content="⚙  设置" FontSize="17" Style="{StaticResource TouchButtonStyle}" MinWidth="104" MinHeight="48" Click="ShowSettings_Click" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1">
            <views:DashboardView x:Name="Dashboard" />
            <views:SettingsView x:Name="Settings" Visibility="Collapsed" />
            <views:LogView x:Name="Log" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
