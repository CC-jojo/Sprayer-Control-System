<UserControl x:Class="SprayerControl.App.Views.SettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:SprayerControl.App.Controls" Background="{DynamicResource HmiBackgroundBrush}">
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid><TextBlock Text="设置" Style="{StaticResource HmiHeadingStyle}" FontSize="28" VerticalAlignment="Center"/><Button Content="返回主界面" Style="{StaticResource TouchButtonStyle}" HorizontalAlignment="Right" Click="Back_Click"/></Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="30*"/><ColumnDefinition Width="38*"/><ColumnDefinition Width="32*"/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,10,0">
    <Border Style="{StaticResource HmiCardStyle}"><StackPanel><TextBlock Text="PWM占空比下限" Style="{StaticResource HmiHeadingStyle}"/><TextBlock x:Name="PwmValue" FontSize="30" Foreground="{DynamicResource HmiCyanBrush}" Margin="0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="−" FontSize="24" Style="{StaticResource TouchButtonStyle}" Margin="0,0,5,0" Click="DecreasePwm_Click"/><Button Grid.Column="1" Content="＋" FontSize="24" Style="{StaticResource TouchButtonStyle}" Margin="5,0,0,0" Click="IncreasePwm_Click"/></Grid></StackPanel></Border>
    <Border Style="{StaticResource HmiCardStyle}" Margin="0,10,0,0"><StackPanel><TextBlock Text="回流阀安全下限" Style="{StaticResource HmiHeadingStyle}"/><TextBlock x:Name="SafetyValue" FontSize="30" Foreground="{DynamicResource HmiAmberBrush}" Margin="0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="−" FontSize="24" Style="{StaticResource TouchButtonStyle}" Margin="0,0,5,0" Click="DecreaseSafety_Click"/><Button Grid.Column="1" Content="＋" FontSize="24" Style="{StaticResource TouchButtonStyle}" Margin="5,0,0,0" Click="IncreaseSafety_Click"/></Grid><Button x:Name="ConfirmSafetyButton" Content="确认安全下限修改" Style="{StaticResource TouchButtonStyle}" BorderBrush="{DynamicResource HmiAmberBrush}" Margin="0,10,0,0" Click="ConfirmSafety_Click"/></StackPanel></Border>
    <Border Style="{StaticResource HmiCardStyle}" Margin="0,10,0,0"><StackPanel><Button x:Name="SaveLocalButton" Content="保存本地配置" Style="{StaticResource StatusButtonStyle}" Click="Save_Click"/><Button x:Name="SaveControllerDefaultButton" Content="保存为上电默认值" Style="{StaticResource TouchButtonStyle}" Margin="0,10,0,0" Click="SaveControllerDefault_Click"/><TextBlock x:Name="ControllerDefaultReason" Text="控制器未连接" Foreground="{DynamicResource HmiMutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
    <TextBlock x:Name="ResultText" Foreground="{DynamicResource HmiAmberBrush}" TextWrapping="Wrap" Margin="4,10"/>
   </StackPanel>

   <Border Grid.Column="1" Style="{StaticResource HmiCardStyle}" Margin="0,0,10,0"><Grid><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="十点开度 / 电流标定（mA）" Style="{StaticResource HmiHeadingStyle}"/><UniformGrid Grid.Row="1" x:Name="CalibrationGrid" Columns="2" Margin="0,8"/><TextBlock Grid.Row="2" Text="触摸任一点打开数字键盘；10% 至 100% 按十点分段线性插值。" Foreground="{DynamicResource HmiMutedTextBrush}" TextWrapping="Wrap"/></Grid></Border>

   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Style="{StaticResource HmiCardStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/><RowDefinition Height="44"/></Grid.RowDefinitions><TextBlock Text="标定曲线预览" Style="{StaticResource HmiHeadingStyle}"/><Viewbox Grid.Row="1" Stretch="Uniform"><Canvas x:Name="CurveCanvas" Width="340" Height="260" Background="{DynamicResource HmiBackgroundBrush}"><Line X1="36" Y1="18" X2="36" Y2="228" Stroke="{DynamicResource HmiBorderBrush}" StrokeThickness="2"/><Line X1="36" Y1="228" X2="322" Y2="228" Stroke="{DynamicResource HmiBorderBrush}" StrokeThickness="2"/><Polyline x:Name="CurveLine" Stroke="{DynamicResource HmiCyanBrush}" StrokeThickness="3"/><TextBlock Canvas.Left="4" Canvas.Top="8" Text="mA" Foreground="{DynamicResource HmiMutedTextBrush}"/><TextBlock Canvas.Left="284" Canvas.Top="232" Text="开度%" Foreground="{DynamicResource HmiMutedTextBrush}"/></Canvas></Viewbox><TextBlock Grid.Row="2" x:Name="MappedCurrentText" Text="安全下限映射电流：-- mA" Foreground="{DynamicResource HmiCyanBrush}" FontSize="16" VerticalAlignment="Center"/></Grid></Border>
    <controls:TouchNumericKeypad x:Name="Keypad" Grid.RowSpan="2" Margin="0" Visibility="Collapsed" Panel.ZIndex="10"/>
   </Grid>
  </Grid>
 </Grid>
</UserControl>
