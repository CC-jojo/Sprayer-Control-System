<UserControl x:Class="SprayerControl.App.Views.LogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource HmiBackgroundBrush}">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><TextBlock Text="全部操作日志" Style="{StaticResource HmiHeadingStyle}" FontSize="30"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="清空日志" Style="{StaticResource TouchButtonStyle}" Click="Clear_Click"/><Button Content="返回" Style="{StaticResource TouchButtonStyle}" Click="Back_Click"/></StackPanel></DockPanel><ListBox Grid.Row="1" x:Name="Entries" Margin="0,18,0,0" Background="{DynamicResource HmiPanelBrush}" Foreground="{DynamicResource HmiTextBrush}" BorderBrush="{DynamicResource HmiBorderBrush}"/></Grid>
</UserControl>
