<UserControl x:Class="SprayerControl.App.Controls.SegmentedGaugeControl"
             x:Name="Root" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" MinWidth="150" MinHeight="150">
    <UserControl.Resources>
        <!-- 加减步进按钮：只在绑定 StepDown/StepUpCommand 时显示 -->
        <Style x:Key="StepButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource HmiCyanBrush}" />
            <Setter Property="Background" Value="{DynamicResource HmiRaisedPanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HmiBorderBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource HmiFocusOverlayBrush}" />
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource HmiCyanBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource HmiCyanBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource HmiBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Command, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 安全下限按钮：一键把开度拉到安全下限（琥珀色，与仪表安全区呼应） -->
        <Style x:Key="SafetyFloorButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource HmiAmberBrush}" />
            <Setter Property="Background" Value="{DynamicResource HmiRaisedPanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HmiAmberBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource HmiFocusOverlayBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource HmiAmberBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource HmiBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Command, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Viewbox Stretch="Uniform">
        <Grid Width="260" Height="260">
            <Canvas Width="260" Height="260">
                <!-- 25 个 Segment：统一绕画布正中心 (130,130) 旋转，间隔 10° -->
                <Rectangle x:Name="Segment01" Width="10" Height="14" Canvas.Left="125" Canvas.Top="28" RenderTransformOrigin="0.5,7.2857"><Rectangle.RenderTransform><RotateTransform Angle="-120" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment02" Width="10" Height="14" Canvas.Left="125" Canvas.Top="28" RenderTransformOrigin="0.5,7.2857"><Rectangle.RenderTransform><RotateTransform Angle="-110" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment03" Width="10" Height="14" Canvas.Left="125" Canvas.Top="28" RenderTransformOrigin="0.5,7.2857"><Rectangle.RenderTransform><RotateTransform Angle="-100" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment04" Width="10" Height="14" Canvas.Left="125" Canvas.Top="28" RenderTransformOrigin="0.5,7.2857"><Rectangle.RenderTransform><RotateTransform Angle="-90" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment05" Width="10" Height="14" Canvas.Left="125" Canvas.Top="28" RenderTransformOrigin="0.5,7.2857"><Rectangle.RenderTransform><RotateTransform Angle="-80" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment06" Width="10" Height="14" Canvas.Left="125" Canvas.Top="28" RenderTransformOrigin="0.5,7.2857"><Rectangle.RenderTransform><RotateTransform Angle="-70" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment07" Width="10" Height="14" Canvas.Left="125" Canvas.Top="28" RenderTransformOrigin="0.5,7.2857"><Rectangle.RenderTransform><RotateTransform Angle="-60" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment08" Width="10" Height="14" Canvas.Left="125" Canvas.Top="28" RenderTransformOrigin="0.5,7.2857"><Rectangle.RenderTransform><RotateTransform Angle="-50" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment09" Width="10" Height="14" Canvas.Left="125" Canvas.Top="28" RenderTransformOrigin="0.5,7.2857"><Rectangle.RenderTransform><RotateTransform Angle="-40" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment10" Width="10" Height="14" Canvas.Left="125" Canvas.Top="28" RenderTransformOrigin="0.5,7.2857"><Rectangle.RenderTransform><RotateTransform Angle="-30" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment11" Width="10" Height="14" Canvas.Left="125" Canvas.Top="28" RenderTransformOrigin="0.5,7.2857"><Rectangle.RenderTransform><RotateTransform Angle="-20" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment12" Width="10" Height="14" Canvas.Left="125" Canvas.Top="28" RenderTransformOrigin="0.5,7.2857"><Rectangle.RenderTransform><RotateTransform Angle="-10" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment13" Width="10" Height="14" Canvas.Left="125" Canvas.Top="28" RenderTransformOrigin="0.5,7.2857"><Rectangle.RenderTransform><RotateTransform Angle="0" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment14" Width="10" Height="14" Canvas.Left="125" Canvas.Top="28" RenderTransformOrigin="0.5,7.2857"><Rectangle.RenderTransform><RotateTransform Angle="10" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment15" Width="10" Height="14" Canvas.Left="125" Canvas.Top="28" RenderTransformOrigin="0.5,7.2857"><Rectangle.RenderTransform><RotateTransform Angle="20" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment16" Width="10" Height="14" Canvas.Left="125" Canvas.Top="28" RenderTransformOrigin="0.5,7.2857"><Rectangle.RenderTransform><RotateTransform Angle="30" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment17" Width="10" Height="14" Canvas.Left="125" Canvas.Top="28" RenderTransformOrigin="0.5,7.2857"><Rectangle.RenderTransform><RotateTransform Angle="40" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment18" Width="10" Height="14" Canvas.Left="125" Canvas.Top="28" RenderTransformOrigin="0.5,7.2857"><Rectangle.RenderTransform><RotateTransform Angle="50" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment19" Width="10" Height="14" Canvas.Left="125" Canvas.Top="28" RenderTransformOrigin="0.5,7.2857"><Rectangle.RenderTransform><RotateTransform Angle="60" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment20" Width="10" Height="14" Canvas.Left="125" Canvas.Top="28" RenderTransformOrigin="0.5,7.2857"><Rectangle.RenderTransform><RotateTransform Angle="70" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment21" Width="10" Height="14" Canvas.Left="125" Canvas.Top="28" RenderTransformOrigin="0.5,7.2857"><Rectangle.RenderTransform><RotateTransform Angle="80" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment22" Width="10" Height="14" Canvas.Left="125" Canvas.Top="28" RenderTransformOrigin="0.5,7.2857"><Rectangle.RenderTransform><RotateTransform Angle="90" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment23" Width="10" Height="14" Canvas.Left="125" Canvas.Top="28" RenderTransformOrigin="0.5,7.2857"><Rectangle.RenderTransform><RotateTransform Angle="100" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment24" Width="10" Height="14" Canvas.Left="125" Canvas.Top="28" RenderTransformOrigin="0.5,7.2857"><Rectangle.RenderTransform><RotateTransform Angle="110" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Segment25" Width="10" Height="14" Canvas.Left="125" Canvas.Top="28" RenderTransformOrigin="0.5,7.2857"><Rectangle.RenderTransform><RotateTransform Angle="120" /></Rectangle.RenderTransform></Rectangle>
            </Canvas>
            <!-- 中间数字显示区：主数字居中；Min/Max 端值移到弧形内侧底部 -->
            <Border Width="142" Height="142" Background="{DynamicResource HmiBackgroundBrush}" BorderBrush="{DynamicResource HmiBorderBrush}" BorderThickness="2" CornerRadius="71" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding PreviewValue, ElementName=Root, StringFormat={}{0:F0}%}" Foreground="{DynamicResource HmiTextBrush}" FontSize="43" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <!-- 端值：放在弧形内侧底部（中心圆下方、按钮上方） -->
            <TextBlock Text="{Binding Minimum, ElementName=Root, StringFormat={}{0:F0}%}" Foreground="{DynamicResource HmiMutedTextBrush}" FontSize="11" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="2,0,0,78" />
            <TextBlock Text="{Binding Maximum, ElementName=Root, StringFormat={}{0:F0}%}" Foreground="{DynamicResource HmiMutedTextBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,78" />
            <Button x:Name="StepDownButton" Style="{StaticResource StepButtonStyle}"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14,0,0,12"
                    Command="{Binding StepDownCommand, ElementName=Root}"
                    IsEnabled="{Binding IsEnabled, ElementName=Root}">
                <Grid Width="20" Height="4">
                    <Rectangle RadiusX="2" RadiusY="2" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Grid>
            </Button>
            <Button x:Name="StepUpButton" Style="{StaticResource StepButtonStyle}"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,12"
                    Command="{Binding StepUpCommand, ElementName=Root}"
                    IsEnabled="{Binding IsEnabled, ElementName=Root}">
                <Grid Width="20" Height="20">
                    <Rectangle Width="20" Height="4" RadiusX="2" RadiusY="2" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    <Rectangle Width="4" Height="20" RadiusX="2" RadiusY="2" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Grid>
            </Button>
            <!-- 安全下限按钮：位于减号与加号之间、数字圆盘正下方 -->
            <Button x:Name="SafetyFloorButton" Style="{StaticResource SafetyFloorButtonStyle}"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,15"
                    Content="安全下限"
                    Command="{Binding SafetyFloorCommand, ElementName=Root}"
                    IsEnabled="{Binding IsEnabled, ElementName=Root}" />
        </Grid>
    </Viewbox>
</UserControl>
