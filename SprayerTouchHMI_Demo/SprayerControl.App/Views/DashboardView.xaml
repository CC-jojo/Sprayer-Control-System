<UserControl x:Class="SprayerControl.App.Views.DashboardView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:SprayerControl.App.Controls" Background="{DynamicResource HmiBackgroundBrush}">
 <UserControl.Resources>
  <Style x:Key="CompactCardStyle" TargetType="Border" BasedOn="{StaticResource HmiCardStyle}"><Setter Property="Padding" Value="14" /></Style>
 </UserControl.Resources>
 <Grid Margin="14">
  <Grid.ColumnDefinitions><ColumnDefinition Width="38*" MinWidth="500"/><ColumnDefinition Width="26*" MinWidth="340"/><ColumnDefinition Width="36*" MinWidth="480"/></Grid.ColumnDefinitions>

  <!-- Left: 8 nozzle discs (clickable) + master PWM switch below. -->
  <Border Grid.Column="0" Style="{StaticResource CompactCardStyle}" Margin="0,0,10,0">
   <Grid><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="喷头开关控制" Style="{StaticResource HmiHeadingStyle}" FontSize="22" />
    <controls:NozzleArrayControl x:Name="Nozzles" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="6,4,4,10" />
    <!-- PWM总开关 -->
    <Button x:Name="PwmMasterButton" Grid.Row="2" Style="{StaticResource StatusButtonStyle}" Click="Pwm_Click" Margin="5,2"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="⏻" Foreground="{DynamicResource HmiGreenBrush}" FontSize="22" FontWeight="Bold" Margin="0,0,8,0"/><StackPanel><TextBlock Text="电磁阀总开关" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock x:Name="PwmStateText" Text="已关闭" Foreground="{DynamicResource HmiMutedTextBrush}" FontSize="18" HorizontalAlignment="Center" Margin="0,6,0,0"/></StackPanel></StackPanel></Button>
   </Grid>
  </Border>

  <!-- Center: two compact gauges stacked vertically. -->
  <Grid Grid.Column="1" Margin="0,0,10,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Style="{StaticResource CompactCardStyle}" Margin="0,0,0,5"><Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="电磁阀占空比" Style="{StaticResource HmiHeadingStyle}" HorizontalAlignment="Center"/><!-- PWM总开关 -->
    <controls:SegmentedGaugeControl Grid.Row="1" x:Name="DutyGauge" Margin="4,2"/>
   </Grid></Border>
   <Border Grid.Row="1" Style="{StaticResource CompactCardStyle}" Margin="0,5,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="回流阀开度" Style="{StaticResource HmiHeadingStyle}" HorizontalAlignment="Center"/>
    <Grid Grid.Row="1"><controls:SegmentedGaugeControl x:Name="OpeningGauge" Margin="4,2"/><StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,2"><TextBlock x:Name="SafetyMinimumText" Text="安全下限 30%" Foreground="{DynamicResource HmiAmberBrush}" FontWeight="SemiBold"/><TextBlock x:Name="MappedCurrentText" Text="映射电流 -- mA" Foreground="{DynamicResource HmiMutedTextBrush}" FontSize="12" HorizontalAlignment="Center"/></StackPanel></Grid>
    <Border Grid.Row="2" Background="#2A1B04" BorderBrush="{DynamicResource HmiAmberBrush}" BorderThickness="1" CornerRadius="5" Margin="4,2" Padding="4"><TextBlock Text="♢  回流全开为安全位置" Foreground="{DynamicResource HmiAmberBrush}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   </Grid></Border>
  </Grid>

  <!-- Right: live connection, authoritative 4x2 readback, newest five logs. -->
  <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="124"/><RowDefinition Height="254"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Style="{StaticResource CompactCardStyle}" Margin="0,0,0,5"><Grid><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="连接状态" Style="{StaticResource HmiHeadingStyle}"/>
    <Grid Grid.Row="1" Margin="5,2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Ellipse x:Name="ConnectionStateDot" Width="40" Height="40" Stroke="{DynamicResource HmiGreenBrush}" StrokeThickness="2" Fill="#132D20"/>
     <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0"><TextBlock x:Name="ConnectionTitle" Text="正在查找控制器" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource HmiTextBrush}"/><TextBlock x:Name="ConnectionSubtext" Text="自动发现与重连已启用" Foreground="{DynamicResource HmiMutedTextBrush}"/></StackPanel>
     <TextBlock x:Name="Facts" Grid.Column="2" Foreground="{DynamicResource HmiMutedTextBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
    </Grid>
    <TextBlock Grid.Row="2" x:Name="ErrorText" Foreground="{DynamicResource HmiRedBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
   </Grid></Border>

   <Border Grid.Row="1" Style="{StaticResource CompactCardStyle}" Margin="0,5"><Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="运行状态" Style="{StaticResource HmiHeadingStyle}"/>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Grid.Column="1" Text="左侧喷头" Foreground="{DynamicResource HmiMutedTextBrush}" HorizontalAlignment="Center"/><TextBlock Grid.Column="2" Text="右侧喷头" Foreground="{DynamicResource HmiMutedTextBrush}" HorizontalAlignment="Center"/></Grid>
    <Grid x:Name="NozzleReadbackGrid" Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
     <TextBlock Grid.Row="0" Text="第1组" Foreground="{DynamicResource HmiTextBrush}" VerticalAlignment="Center"/><TextBlock Grid.Row="1" Text="第2组" Foreground="{DynamicResource HmiTextBrush}" VerticalAlignment="Center"/><TextBlock Grid.Row="2" Text="第3组" Foreground="{DynamicResource HmiTextBrush}" VerticalAlignment="Center"/><TextBlock Grid.Row="3" Text="第4组" Foreground="{DynamicResource HmiTextBrush}" VerticalAlignment="Center"/>
     <Border x:Name="State1L" Grid.Row="0" Grid.Column="1"/><Border x:Name="State1R" Grid.Row="0" Grid.Column="2"/><Border x:Name="State2L" Grid.Row="1" Grid.Column="1"/><Border x:Name="State2R" Grid.Row="1" Grid.Column="2"/><Border x:Name="State3L" Grid.Row="2" Grid.Column="1"/><Border x:Name="State3R" Grid.Row="2" Grid.Column="2"/><Border x:Name="State4L" Grid.Row="3" Grid.Column="1"/><Border x:Name="State4R" Grid.Row="3" Grid.Column="2"/>
    </Grid>
   </Grid></Border>

   <Border Grid.Row="2" Style="{StaticResource CompactCardStyle}" Margin="0,6,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/><RowDefinition Height="68"/><RowDefinition Height="0"/><RowDefinition Height="0"/></Grid.RowDefinitions>
    <TextBlock Text="操作日志" Style="{StaticResource HmiHeadingStyle}" FontSize="22"/>
    <ListBox Grid.Row="1" x:Name="RecentLog" Background="Transparent" Foreground="{DynamicResource HmiTextBrush}" BorderThickness="0" IsHitTestVisible="False">
     <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="5"/></ItemsPanelTemplate></ListBox.ItemsPanel>
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource HmiBorderBrush}" BorderThickness="0,0,0,1" Padding="6,6"><Grid VerticalAlignment="Stretch"><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><Ellipse Width="8" Height="8" Fill="{DynamicResource HmiCyanBrush}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding}" FontSize="15" Foreground="{DynamicResource HmiTextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <Button Grid.Row="2" Content="▤  查看全部日志" Foreground="{DynamicResource HmiCyanBrush}" Style="{StaticResource TouchButtonStyle}" Click="ShowLog_Click" Margin="4,6,4,0" FontSize="18"/>
   </Grid></Border>
  </Grid>
 </Grid>
</UserControl>
